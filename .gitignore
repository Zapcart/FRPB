# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
out/
dist/
build/
release/
*.tsbuildinfo

# Env files (never commit secrets)
.env
.env.*
!.env.example

# Prisma
apps/web/prisma/*.db

# Web download artifacts — ignore stray files, but ship the installer binaries
apps/web/public/downloads/*
!apps/web/public/downloads/*.exe
!apps/web/public/downloads/*.dmg
!apps/web/public/downloads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Turbo
.turbo/

# Electron
apps/desktop/dist-electron/
apps/desktop/release/

# Local installer test artifacts (never commit)
.tmp-nsis-test/
