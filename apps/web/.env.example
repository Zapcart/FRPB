# FRPB — Environment variables example
# Copy to `apps/web/.env`. Never commit real values.

# ─── Supabase (Auth + Postgres) ─────────────────────────────────────────────
# Managed PostgreSQL + Auth. Used by the browser client, server client, and
# middleware for session handling.
# Get from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Database (Prisma) ──────────────────────────────────────────────────────
# Direct PostgreSQL connection string for Prisma migrations / queries.
# Get from Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?pgbouncer=true

# ─── App URL ────────────────────────────────────────────────────────────────
# Base URL of the deployed web app (metadata, checkout redirects, CORS).
NEXT_PUBLIC_APP_URL=https://frpb.in

# ─── Downloads ──────────────────────────────────────────────────────────────
# Public installer URL surfaced on the landing page + dashboard.
NEXT_PUBLIC_DOWNLOAD_URL=https://frpb.in/downloads/FRPB-Setup.exe
# Base path/URL used by the downloads redirect route ([file]/route.ts).
DOWNLOAD_BASE_URL=https://frpb.in/downloads
# Optional: public/CDN base if it differs from DOWNLOAD_BASE_URL.
# NEXT_PUBLIC_DOWNLOAD_BASE_URL=https://cdn.frpb.in/downloads
# Desktop installer version. Keep in sync with apps/desktop/package.json
# "version"; used to map the public "FRPB-Setup.exe" alias onto the real
# electron-builder release asset "FRPB-Recovery-Setup-<version>.exe".
NEXT_PUBLIC_APP_VERSION=1.0.1

# ─── PostHog (product analytics) ────────────────────────────────────────────
# Browser-side key (public, safe to expose to the client).
# Get from: https://app.posthog.com → Project Settings → API Keys → "Client key"
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side key (PRIVATE — posthog-node, server-only ingestion).
# Empty ⇒ server-side capture becomes a safe no-op.
# Get from: https://app.posthog.com → Project Settings → API Keys → "Internal API key"
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ─── Admin analytics ────────────────────────────────────────────────────────
# Owner secret guarding GET /api/v1/admin/analytics (Bearer token) and /admin.
# Set to any secret string you choose (e.g. a real FRPB license key you own).
ADMIN_LICENSE_KEY=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Transactional email for license delivery (lib/email/resend.ts).
# Get from: https://resend.com → API Keys
RESEND_API_KEY=
EMAIL_FROM="FRPB <no-reply@frpb.in>"
# Optional: override the quick-start guide link embedded in delivery emails.
# QUICK_START_PDF_URL=https://frpb.in/guides/frpb-quick-start.pdf

# ─── Rate limit (Upstash Redis) ────────────────────────────────────────────
# REST credentials for distributed rate limiting + brute-force lockout.
# Falls back to in-memory per-process limits when absent.
# Get from: https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Payments (Stripe) ──────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Payments (Razorpay) ────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Payments (Cashfree) ────────────────────────────────────────────────────
# Get from: https://dashboard.cashfree.com → Settings → API Keys
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional overrides (defaults: prod API base + version 2023-08-01).
# CASHFREE_API_BASE=https://api.cashfree.com/pg
# CASHFREE_API_VERSION=2023-08-01
# CASHFREE_NOTIFY_URL=https://frpb.in/api/v1/webhooks/cashfree
