# FRPB — Environment variables example
# Copy to .env.local (web) and .env (desktop root) — never commit real values.

# ─── Supabase ──────────────────────────────────────────────────────────────
# Managed PostgreSQL + Auth + Realtime (Supabase project).
# Get these from: https://supabase.com/dashboard  →  Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── PostHog (product analytics) ────────────────────────────────────────────
# Browser-side key (public, safe to expose to the client).
# Get from: https://app.posthog.com  →  Project Settings → API Keys → "Client key"
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog API host (default US instance; change for EU / self-hosted).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side key (PRIVATE — only used by API routes & server components).
# Get from: https://app.posthog.com  →  Project Settings → API Keys → "Internal API key"
# Used by: /api/v1/checkout, /api/v1/frp/request, /api/v1/admin/analytics (optional pageview ingestion)
POSTHOG_API_KEY=

# ─── Admin analytics ────────────────────────────────────────────────────────
# Owner license key used to guard GET /api/v1/admin/analytics (Bearer token).
# Set to any secret string you choose (e.g. a real FRPB license key you own).
# The admin page will pass this as `Authorization: Bearer $ADMIN_LICENSE_KEY`
# so only someone who knows this value can read the analytics endpoint.
ADMIN_LICENSE_KEY=

# ─── App URL ────────────────────────────────────────────────────────────────
# Base URL of the deployed web app (used for checkout redirect URLs, CORS, etc.)
NEXT_PUBLIC_APP_URL=https://frpb.in

# ─── Email (Resend / SendGrid) ──────────────────────────────────────────────
# Optional: transactional email for license delivery / password resets.
# RESEND_API_KEY=sk_...
# SENDGRID_API_KEY=SG....
# EMAIL_FROM=noreply@yourdomain.com

# ─── Rate limit (Upstash Redis) ────────────────────────────────────────────
# Optional: Redis URL for distributed rate limiting. Falls back to in-memory
# per-process limits when absent (fine for small deployments).
# UPSTASH_REDIS_URL=redis://default:password@endpoint:6379

# ─── Database (Prisma / Supabase) ───────────────────────────────────────────
# Direct PostgreSQL connection string for migrations / Prisma CLI.
# Get from Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?pgbouncer=true

# ─── Payment (Cashfree) ─────────────────────────────────────────────────────
# Cashfree credentials for the checkout + webhook flow.
# Get from: https://dashboard.cashfree.com  →  Settings → API Keys
# Test credentials prefixed with test_ / test-secret_ for sandbox.
CASHFREE_API_KEY=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
