# FRPB — apps/web environment template.
# Copy to `.env` (or `.env.local`) and fill in real values. Never commit secrets.

# ── Database (Supabase Postgres) ───────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── App URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://frpb.in"

# ── Supabase Auth ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL="https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json"

# ── Download targets ───────────────────────────────────────────────────────
# Full URL to a specific installer asset. Used by the landing page and the
# /downloads/[file] redirect.
NEXT_PUBLIC_DOWNLOAD_URL="https://frpb.in/downloads/FRPB-Setup.exe"
# Base directory (server-side) that installer filenames are appended to.
# Used by email templates and the /downloads/[file] fallback.
DOWNLOAD_BASE_URL="https://frpb.in/downloads"
# Optional client-visible base override for /downloads/[file].
NEXT_PUBLIC_DOWNLOAD_BASE_URL=""
QUICK_START_PDF_URL="https://frpb.in/guides/frpb-quick-start.pdf"

# ── Rate limiting / lockout (Upstash Redis REST) ────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Payments: Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Payments: Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Payments: Cashfree ─────────────────────────────────────────────────────
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
# API host — use https://sandbox.cashfree.com/pg for sandbox testing.
CASHFREE_API_BASE="https://api.cashfree.com/pg"
CASHFREE_API_VERSION="2023-08-01"
# Public URL Cashfree calls for order status notifications (your deployed
# /api/v1/webhooks/cashfree endpoint).
CASHFREE_NOTIFY_URL=""

# ── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=""
