# FRPB — Environment variables example (apps/web)
# Copy to `apps/web/.env` and fill in real values. Never commit `.env`.
#
# IMPORTANT: every key below is READ BY CODE. The names are exact — renaming a
# key silently disables the feature that depends on it (a wrong name for a
# payment key makes checkout fail with a 502 "not configured", not a crash).
#
# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Canonical public origin. Used for canonical URLs, OG tags, sitemap entries
# and the gateway return URLs. No trailing slash.
NEXT_PUBLIC_APP_URL=https://frpb.in

# Desktop installer version. Must match apps/desktop/package.json "version";
# used to map the public FRPB-Setup.exe alias onto the real release asset.
NEXT_PUBLIC_APP_VERSION=1.0.1

# ---------------------------------------------------------------------------
# Supabase (Auth) + Prisma (Database)
# ---------------------------------------------------------------------------
# Get from: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pooled connection string used by Prisma at runtime.
# Supabase: Project Settings -> Database -> Connection string -> URI
# NOTE: this project connects on the transaction pooler port 6543.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres

# Optional: direct (non-pooled) connection, only needed if you run migrations.
# Unused by the runtime code today — leave blank unless your tooling needs it.
# DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Downloads
# ---------------------------------------------------------------------------
# Public installer URL surfaced on the landing page, dashboard and emails.
NEXT_PUBLIC_DOWNLOAD_URL=https://frpb.in/downloads/FRPB-Setup.exe

# Base path/URL used by the downloads redirect route ([file]/route.ts) and as
# the download link base inside delivery emails.
DOWNLOAD_BASE_URL=https://frpb.in/downloads

# Optional: public/CDN base when it differs from DOWNLOAD_BASE_URL.
# NEXT_PUBLIC_DOWNLOAD_BASE_URL=https://cdn.frpb.in/downloads

# Optional: quick-start guide link embedded in delivery emails.
# QUICK_START_PDF_URL=https://frpb.in/guides/frpb-quick-start.pdf

# ---------------------------------------------------------------------------
# Domestic payments — Cashfree (INR)
# ---------------------------------------------------------------------------
# Selected automatically when the customer pays in INR. Never shown in the UI.
# Get from: https://dashboard.cashfree.com -> Developers -> API Keys
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Optional overrides.
# CASHFREE_API_BASE=https://api.cashfree.com/pg        (sandbox: https://sandbox.cashfree.com/pg)
# CASHFREE_API_VERSION=2023-08-01
# CASHFREE_NOTIFY_URL=https://frpb.in/api/v1/webhooks/cashfree

# ---------------------------------------------------------------------------
# International payments — PayGlocal (USD)
# ---------------------------------------------------------------------------
# Selected automatically when the customer pays in USD. Never shown in the UI.
# PAYGLOCAL_MERCHANT_SECRET is ALSO used to verify inbound webhook signatures.
# Get from: your PayGlocal merchant dashboard
PAYGLOCAL_MERCHANT_ID=
PAYGLOCAL_MERCHANT_KEY=
PAYGLOCAL_MERCHANT_SECRET=

# Optional overrides.
# PAYGLOCAL_API_BASE=https://api.payglocal.in              (sandbox: https://api-sandbox.payglocal.in)
# PAYGLOCAL_API_VERSION=v1

# ---------------------------------------------------------------------------
# Transactional email (Resend)
# ---------------------------------------------------------------------------
# Delivers the license key. Delivery is best-effort and NEVER blocks a grant;
# failures are retried by /api/v1/cron/email-retry and the key is always
# recoverable from the dashboard ("Reveal key").
# Get from: https://resend.com -> API Keys
RESEND_API_KEY=
EMAIL_FROM="FRPB Support <support@frpb.in>"

# ---------------------------------------------------------------------------
# Security / cron
# ---------------------------------------------------------------------------
# Bearer token guarding GET /api/v1/cron/email-retry. The endpoint FAILS CLOSED:
# if this is unset the route returns 503 rather than running unauthenticated.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Owner secret guarding GET /api/v1/admin/analytics (Bearer token) and /admin.
# Any long random string.
ADMIN_LICENSE_KEY=

# Dev/test bypass flag. The `FRPB-TEST-*` master key is PUBLISHED in this
# repository, so it is declined whenever NODE_ENV === "production" unless this
# is explicitly set to the exact string "true" (fail-closed otherwise).
# Never enable this on a public production deployment.
# ALLOW_DEV_TEST_KEYS=true

# ---------------------------------------------------------------------------
# Rate limiting (Upstash Redis) — OPTIONAL
# ---------------------------------------------------------------------------
# Distributed rate limiting + brute-force lockout for /api/v1/license/verify.
# When absent the app falls back to in-memory per-process limits (fine for a
# single instance, not for serverless/multi-region).
# Get from: https://console.upstash.com -> your database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Analytics (PostHog) — OPTIONAL
# ---------------------------------------------------------------------------
# Browser-side key (public, safe to expose).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side key (PRIVATE — posthog-node). Empty makes server capture a no-op.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
