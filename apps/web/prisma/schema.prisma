// FRPB — Database Schema
// Supabase PostgreSQL via Prisma ORM
// See plans/frpb-architecture-blueprint.md §4 for design rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection. For Supabase this should target the transaction pooler
  // (port 6543) WITH `?pgbouncer=true&connection_limit=1` appended, otherwise
  // Prisma's prepared statements are rejected by PgBouncer/Supavisor and the
  // app degrades intermittently ("Database connecting…").
  url       = env("DATABASE_URL")
  // Migration/DDL connection. Points at the DIRECT (session, port 5432) URL so
  // `prisma migrate` never runs through the pooler. Without this, migrations
  // are executed against 6543 and can hang or corrupt advisory-lock state.
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────

enum PlanType {
  MONTH_1
  YEAR_1
  LIFETIME
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING
}

// Provider of record for a settled transaction.
//
// ── ACTIVE RAILS (the only ones any code path may construct) ────────────────
//   PAYGLOCAL — international / USD card rail (hosted checkout). The sole live
//               gateway; the ONLY member `lib/payments/gateway.ts`
//               (PaymentProviderName) permits.
//
// Direct UPI is intentionally NOT a member here: it is self-hosted (no gateway
// account) and is tracked on `PaymentOrder.provider = "UPI"` instead. See the
// PaymentOrder model below.
//
// ── DEPRECATED / HISTORICAL (must NOT be used for new orders) ───────────────
//   STRIPE, RAZORPAY, CASHFREE
//
// These are retained solely so historical `Payment` / `WebhookEvent` rows keep
// validating. The Cashfree adapter and its webhook route were DELETED, and INR
// now settles exclusively through the self-hosted Direct UPI engine, so no
// runtime code can produce these values (see lib/payments/index.ts and
// lib/webhooks/processor.ts `LegacyPaymentProvider`).
//
// ENFORCEMENT: the live route code is strictly typed to `"PAYGLOCAL"`; this enum
// is intentionally WIDER than the live union so legacy rows never break. Drop a
// deprecated value ONLY after confirming zero rows reference it.
enum PaymentProvider {
  STRIPE // DEPRECATED — historical rows only
  RAZORPAY // DEPRECATED — historical rows only
  CASHFREE // DEPRECATED — was the INR card rail; INR now uses Direct UPI
  PAYGLOCAL // ACTIVE — international / USD cards (only live gateway)
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DeviceStatus {
  CONNECTED
  DISCONNECTED
  UNAUTHORIZED
  UNBOUND // freed slot via self-service HWID reset (enhancement §3)
}

// ─── Users ────────────────────────────────────────────────

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  supabaseId String?   @unique // Supabase Auth user UUID for binding
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  licenses   License[]
  payments   Payment[]
  frpRequests FrpUnlockRequest[]
  paymentOrders PaymentOrder[]
}

// ─── Plans ────────────────────────────────────────────────

model Plan {
  id           String    @id @default(cuid())
  slug         PlanType  @unique
  name         String // "1-Month Plan", "1-Year Plan", "Lifetime Plan"
  priceCents   Int // USD price in cents ($19.99 = 1999)
  priceInr     Int       @default(0) // INR price in paise (₹1,900 = 190000)
  currency     String    @default("USD")
  durationDays Int? // null = lifetime
  deviceLimit  Int // 1 / 3 / 5
  features     String[] // feature list displayed on pricing cards
  createdAt    DateTime  @default(now())

  licenses License[]
}

// ─── Licenses ─────────────────────────────────────────────

model License {
  id             String        @id @default(cuid())
  key            String        @unique // "FRPB-XXXX-XXXX-XXXX"
  keySha256      String        @unique // hashed for lookup + raw stored encrypted
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan          @relation(fields: [planId], references: [id])
  status         LicenseStatus @default(ACTIVE)
  deviceLimit    Int // snapshot of plan.deviceLimit at purchase time
  maxActivations Int           @default(1) // 1 activation per machine at a time
  activatedAt    DateTime?
  expiresAt      DateTime?
  lastVerifiedAt DateTime?
  /// Audit: how many times the full key has been revealed via /license/reveal.
  revealCount    Int           @default(0)
  /// Audit: timestamp of the most recent key reveal.
  lastRevealedAt DateTime?
  revokedReason  String?
  metadata       Json? // orderId, promoCode etc.
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  devices   LicenseDevice[]
  payment   Payment?
  emailLogs EmailLog[]
  paymentOrder PaymentOrder?

  @@index([userId])
  @@index([status])
  @@index([metadata]) // GIN index for JSON metadata queries (UTR lookup etc.)
}

// ─── Dual-rail Payment Orders (Direct UPI + PayGlocal) ────
//
// One row per customer-initiated payment intent, covering BOTH rails:
//   • provider UPI       — Direct UPI (zero-MDR), amount in INR rupees
//   • provider PAYGLOCAL — international card, amount in whole USD dollars
//
// The amount is ALWAYS resolved server-side from config/plans.ts and is never
// taken from the client, so a tampered payload cannot under-pay. `utr` and
// `providerTxnId` each carry a unique index so a reference can never be claimed
// twice (double-spend / duplicate-claim protection). Orders expire after 10
// minutes.
//
// FRAUD PROTECTION FIELDS:
//   - paymentConfirmed: When true, the payment has been verified by admin
//     (bank statement match) or by a hosted gateway webhook. When false,
//     the license is NOT granted even if UTR is structurally valid.
//   - utrSuspicious: When true, the UTR passed format check but has suspicious
//     patterns (all same digits, sequential, repeated pairs). Admin review
//     recommended before granting license.

enum UpiOrderStatus {
  PENDING
  /// Customer submitted a UTR; awaiting manual admin verification + approval.
  PENDING_VERIFICATION
  PAID
  FAILED
  EXPIRED
}

model PaymentOrder {
  id        String         @id @default(cuid())
  orderId   String         @unique // public order reference (UPI `tr` field)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  planId    PlanType
  // Whole major units in `currency`: INR rupees (1900/4900/9999) for the UPI
  // rail, or whole USD dollars (20/50/100) for the PayGlocal rail. Always
  // resolved server-side from config/plans.ts — never taken from the client.
  amount    Float
  /// "INR" (Direct UPI) | "USD" (PayGlocal card).
  currency  String         @default("INR")
  /// "UPI" (Direct UPI, self-hosted) | "PAYGLOCAL" (card) — which rail created
  /// this order. This is the LIVE rail ledger; `PaymentProvider` above is the
  /// hosted-gateway enum used by the legacy `Payment` table.
  provider  String         @default("UPI")
  status    UpiOrderStatus @default(PENDING)
  utr       String?        @unique // 12-digit UPI reference; unique = no double-claim
  /// PayGlocal order/txn id — unique so a webhook cannot double-grant.
  providerTxnId String?    @unique
  licenseId String?        @unique
  license   License?       @relation(fields: [licenseId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  expiresAt DateTime // createdAt + 10 minutes
  paidAt    DateTime?

  // FRAUD PROTECTION: When true, payment has been manually confirmed by admin
  // (bank statement verified) or by hosted gateway webhook. When false, the
  // self-hosted UPI rail has NOT confirmed the actual bank transfer — only
  // structural UTR validation has been done.
  paymentConfirmed Boolean @default(false)

  // FRAUD PROTECTION: When true, the UTR looks suspicious (all same digits,
  // sequential, repeated pairs). Admin should review before confirming payment.
  utrSuspicious    Boolean @default(false)

  @@index([status, expiresAt])
  @@index([email])
  @@index([provider, status])
  @@index([paymentConfirmed, status]) // Find unconfirmed payments for admin review
  @@index([utrSuspicious]) // Find suspicious UTRs for admin review
}

// ─── Hardware-bound devices ───────────────────────────────

model LicenseDevice {
  id          String       @id @default(cuid())
  licenseId   String
  license     License      @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  hardwareId  String // machine fingerprint
  deviceName  String // hostname / OS label reported by client
  status      DeviceStatus @default(CONNECTED)
  lastSeenAt  DateTime     @default(now())
  unboundAt   DateTime? // last time user unbound this machine (self-service reset)
  unbindCount Int          @default(0) // total unbind operations for this device
  createdAt   DateTime     @default(now())

  @@unique([licenseId, hardwareId])
  @@index([hardwareId])
}

// ─── Payments ─────────────────────────────────────────────

model Payment {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseId        String?         @unique
  license          License?        @relation(fields: [licenseId], references: [id])
  provider         PaymentProvider
  providerTxnId    String          @unique // PayGlocal order id (hosted-gateway rail)
  providerEventId  String? // webhook event id for idempotency
  amountCents      Int
  currency         String          @default("USD")
  status           PaymentStatus   @default(PENDING)
  planSlug         PlanType
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([provider, providerTxnId])
}

// ─── Webhook Idempotency ─────────────────────────────────

model WebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider // PAYGLOCAL live (STRIPE/RAZORPAY/CASHFREE deprecated)
  eventId     String          @unique // provider event id (e.g., evt_..., event_...)
  eventType   String // payment_intent.succeeded / payment.captured
  payload     Json // raw provider payload for audit + replay
  status      String          @default("RECEIVED") // RECEIVED | PROCESSING | PROCESSED | FAILED | IGNORED
  processedAt DateTime?
  licenseId   String?
  error       String? // error message if processing failed
  createdAt   DateTime        @default(now())

  @@index([provider, status])
  @@index([licenseId])
}

// ─── Email Delivery Log (Resend / SendGrid) ──────────────

model EmailLog {
  id            String    @id @default(cuid())
  to            String // recipient email
  template      String // "license-delivered" | "quick-start"
  licenseId     String?
  license       License?  @relation(fields: [licenseId], references: [id])
  providerMsgId String? // Resend message id / SendGrid message id
  status        String    @default("QUEUED") // QUEUED | SENT | FAILED
  error         String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  // Delivery attempts, incremented by the retry pass. Bounded so a permanently
  // bad address is never hammered (see retryFailedEmails in lib/email/resend.ts).
  attempts      Int       @default(0)

  @@index([to])
  @@index([licenseId])
  // Supports the retry backlog query: status IN (QUEUED, FAILED) + createdAt.
  @@index([status, createdAt])
}

// ─── FRP Unlock Requests ───────────────────────────────────

enum FrpRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model FrpUnlockRequest {
  id             String           @id @default(cuid())
  brand          String
  model          String
  androidVersion String?          // e.g. "13", "14", "15"
  imeiHash       String?          // salted SHA-256 of IMEI for privacy-safe dedupe/lookup
  method         String           // setup-wizard | download-mode | edl-mode | mtk-brom | oem-service
  ipAddress      String
  status         FrpRequestStatus @default(PENDING)
  statusMessage  String?          // human-readable status / result message
  result         Json?            // bypass result details (device info, bypassed account type, etc.)
  userId         String?          // if authenticated
  user           User?            @relation(fields: [userId], references: [id])
  requestedAt    DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  refundAmountCents Int?          // if refunded

  @@index([status])
  @@index([userId])
  @@index([imeiHash])
}
