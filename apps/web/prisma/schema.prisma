// FRPB — Database Schema
// Supabase PostgreSQL via Prisma ORM
// See plans/frpb-architecture-blueprint.md §4 for design rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────

enum PlanType {
  MONTH_1
  LIFETIME
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING
}

enum PaymentProvider {
  STRIPE // DEPRECATED — historical rows only
  RAZORPAY // ACTIVE — the single, exclusive payment gateway
  CASHFREE // DEPRECATED — historical rows only
  PAYGLOCAL // DEPRECATED — historical rows only
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DeviceStatus {
  CONNECTED
  DISCONNECTED
  UNAUTHORIZED
  UNBOUND // freed slot via self-service HWID reset (enhancement §3)
}

// ─── Users ────────────────────────────────────────────────

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  supabaseId String?   @unique // Supabase Auth user UUID for binding
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // ─── Referral / affiliate state (Task J) ───
  isLifetimeUnlocked Boolean      @default(false) // gamified FREE $150 unlock reached
  unlockRoute        UnlockRoute? // which route (or downsell) unlocked it
  unlockedAt         DateTime?
  cashBalanceCents   Int          @default(0) // released affiliate cash available for payout

  licenses   License[]
  payments   Payment[]
  frpRequests FrpUnlockRequest[]
  paymentOrders PaymentOrder[]
  pageViews   PageView[]

  referralCode      ReferralCode?  @relation("UserReferralCode")
  referralsMade     Referral[]     @relation("ReferralReferrer")
  referredBy        Referral?      @relation("ReferralReferred")
  commissions       Commission[]
  payoutRequests    PayoutRequest[]
}

// ─── Plans ────────────────────────────────────────────────

model Plan {
  id           String    @id @default(cuid())
  slug         PlanType  @unique
  name         String
  priceCents   Int
  priceInr     Int       @default(0)
  currency     String    @default("USD")
  durationDays Int?
  deviceLimit  Int
  features     String[]
  createdAt    DateTime  @default(now())

  licenses License[]
}

// ─── Licenses ─────────────────────────────────────────────

model License {
  id             String        @id @default(cuid())
  key            String        @unique
  keySha256      String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan          @relation(fields: [planId], references: [id])
  status         LicenseStatus @default(ACTIVE)
  deviceLimit    Int
  maxActivations Int           @default(1)
  activatedAt    DateTime?
  expiresAt      DateTime?
  lastVerifiedAt DateTime?
  revealCount    Int           @default(0)
  lastRevealedAt DateTime?
  revokedReason  String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  devices   LicenseDevice[]
  payment   Payment?
  emailLogs EmailLog[]
  paymentOrder PaymentOrder?

  @@index([userId])
  @@index([status])
  @@index([metadata])
}

// ─── Dual-rail Payment Orders ─────────────────────────────

enum UpiOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  PENDING_VERIFICATION
}

model PaymentOrder {
  id        String         @id @default(cuid())
  orderId   String         @unique
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  planId    PlanType
  amount    Float
  currency  String         @default("INR")
  provider  String         @default("UPI")
  status    UpiOrderStatus @default(PENDING)
  utr       String?        @unique
  providerTxnId String?    @unique
  licenseId String?        @unique
  license   License?       @relation(fields: [licenseId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  expiresAt DateTime
  paidAt    DateTime?

  paymentConfirmed Boolean @default(false)
  utrSuspicious    Boolean @default(false)

  // ─── Referral capture (Task J) ───
  // The referral code entered at checkout, persisted BEFORE payment so it can be
  // attributed to the referrer at settlement (markRazorpayOrderPaid / webhook).
  referralCode String?

  @@index([status, expiresAt])
  @@index([email])
  @@index([provider, status])
  @@index([paymentConfirmed, status])
  @@index([utrSuspicious])
  @@index([referralCode])
}

// ─── Hardware-bound devices ───────────────────────────────

model LicenseDevice {
  id          String       @id @default(cuid())
  licenseId   String
  license     License      @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  hardwareId  String
  deviceName  String
  status      DeviceStatus @default(CONNECTED)
  lastSeenAt  DateTime     @default(now())
  unboundAt   DateTime?
  unbindCount Int          @default(0)
  createdAt   DateTime     @default(now())

  @@unique([licenseId, hardwareId])
  @@index([hardwareId])
}

// ─── Payments ─────────────────────────────────────────────

model Payment {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseId        String?         @unique
  license          License?        @relation(fields: [licenseId], references: [id])
  provider         PaymentProvider
  providerTxnId    String          @unique
  providerEventId  String?
  amountCents      Int
  currency         String          @default("USD")
  status           PaymentStatus   @default(PENDING)
  planSlug         PlanType
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([provider, providerTxnId])
}

// ─── Webhook Idempotency ─────────────────────────────────

model WebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventId     String          @unique
  eventType   String
  payload     Json
  status      String          @default("RECEIVED")
  processedAt DateTime?
  licenseId   String?
  error       String?
  createdAt   DateTime        @default(now())

  @@index([provider, status])
  @@index([licenseId])
}

// ─── Email Delivery Log ───────────────────────────────────

model EmailLog {
  id            String    @id @default(cuid())
  to            String
  template      String
  licenseId     String?
  license       License?  @relation(fields: [licenseId], references: [id])
  providerMsgId String?
  status        String    @default("QUEUED")
  error         String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  attempts      Int       @default(0)

  @@index([to])
  @@index([licenseId])
  @@index([status, createdAt])
}

// ─── FRP Unlock Requests ───────────────────────────────────

enum FrpRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model FrpUnlockRequest {
  id             String           @id @default(cuid())
  brand          String
  model          String
  androidVersion String?
  imeiHash       String?
  method         String
  ipAddress      String
  status         FrpRequestStatus @default(PENDING)
  statusMessage  String?
  result         Json?
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  requestedAt    DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  refundAmountCents Int?

  @@index([status])
  @@index([userId])
  @@index([imeiHash])
}

// ─── First-party Page Views (admin VISITORS metric) ────────
//
// WHY THIS EXISTS: the admin "VISITORS (30D)" card previously derived its figure
// from `FrpUnlockRequest.ipAddress`, so it counted only the handful of users who
// filed an unlock request — NOT actual site traffic. This table records a
// privacy-preserving page view on every landing so the metric reflects real
// visitation. No raw IP is stored: `visitorHash` is a salted SHA-256 of the
// IP + user-agent, giving a stable per-visitor key that cannot be reversed.
//
// The metric intentionally stays on our own infrastructure (not PostHog) so it
// still works when PostHog is unconfigured or blocked by an ad-blocker.

enum PageViewSource {
  WEB
  DESKTOP
  BOT
}

model PageView {
  id          String         @id @default(cuid())
  path        String
  visitorHash String
  source      PageViewSource @default(WEB)
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@index([visitorHash, createdAt])
  @@index([userId])
}

// ─── Referral / Gamified Unlock / VIP Cash Affiliate (Task J) ───
//
// WHY THIS EXISTS: the growth engine rewards users for referring friends with a
// FREE $150 Lifetime unlock (gamified battery bar) and, once unlocked, a VIP cash
// affiliate program. Money is always stored as INTEGER CENTS to avoid float drift.
// Referral credits/commissions stay PENDING for a 14-day refund-lock window before
// they can be released or cashed out — this defends against chargeback/refund
// exploits. Self-referral is blocked via IP-hash + visitorHash + email signals.

enum UnlockRoute {
  ROUTE_A // 2 × Lifetime referrals ($240 upfront)
  ROUTE_B // 4 × Monthly + 1 × Lifetime referral ($200 upfront)
  DOWNSELL // partial credit: 50% ($75) discount accepted before full unlock
}

enum ReferralStatus {
  PENDING // recorded, pending 14-day refund lock
  QUALIFIED // verified paid + past refund window
  REJECTED // refunded / fraudulent / self-referral
}

enum CommissionKind {
  MONTHLY_RECURRING // 30% of a referred $20/mo sale
  LIFETIME_UPFRONT // 50% of a referred $150 lifetime sale
}

enum CommissionStatus {
  PENDING // within 14-day refund lock
  RELEASED // credited to referrer cash balance
  REJECTED // reversed (refund / fraud)
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

/// One shareable code per user. `code` is unique so a race cannot mint dupes.
model ReferralCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String   @unique
  user      User     @relation("UserReferralCode", fields: [userId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals Referral[]

  @@index([userId])
}

/// A single referral event: referrer invited (and referred user purchased with)
/// `code`. `referredUserId` is unique — a buyer can only ever be referred once.
model Referral {
  id             String         @id @default(cuid())
  codeId         String
  code           ReferralCode   @relation(fields: [codeId], references: [id], onDelete: Cascade)
  referrerId     String
  referrer       User           @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String         @unique
  referredUser   User           @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  planId         PlanType
  amountPaidCents Int           @default(0) // actual charged (post-discount) cents
  discountCents  Int            @default(0) // discount applied to referred buyer
  selfReferral   Boolean        @default(false) // fraud flag
  ipHash         String? // salted SHA-256 of referrer/referred IP (fraud signal)
  visitorHash    String? // salted device/UA fingerprint (fraud signal)
  qualifiesUnlock Boolean       @default(false) // counts toward Route A/B unlock
  status         ReferralStatus @default(PENDING)
  releaseAt      DateTime // paidAt + 14-day refund lock
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  commissions Commission[]

  @@index([referrerId, status])
  @@index([codeId])
  @@index([status, releaseAt])
}

/// Immutable cash-commission ledger. `@@unique([referralId, kind])` guarantees a
/// given referral can never accrue the same kind of commission twice (idempotency).
model Commission {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralId String
  referral   Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  kind       CommissionKind
  baseCents  Int // the referred sale amount the rate applies to
  rateBps    Int // rate in basis points (3000 = 30%, 5000 = 50%)
  amountCents Int // computed payout (base * rate / 10000)
  status     CommissionStatus @default(PENDING)
  releaseAt  DateTime // paidAt + 14-day refund lock
  releasedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([referralId, kind])
  @@index([userId, status])
  @@index([status, releaseAt])
}

/// A cash-out request against a user's released balance.
model PayoutRequest {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int
  method      String       @default("UPI")
  destination String? // payout handle/account reference
  status      PayoutStatus @default(REQUESTED)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}
