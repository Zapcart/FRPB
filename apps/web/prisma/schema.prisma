// FRPB — Database Schema
// Supabase PostgreSQL via Prisma ORM
// See plans/frpb-architecture-blueprint.md §4 for design rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────

enum PlanType {
  MONTH_1
  YEAR_1
  LIFETIME
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING
}

enum PaymentProvider {
  STRIPE // DEPRECATED — historical rows only
  RAZORPAY // DEPRECATED — historical rows only
  CASHFREE // DEPRECATED — was the INR card rail; INR now uses Direct UPI
  PAYGLOCAL // ACTIVE — international / USD cards (only live gateway)
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DeviceStatus {
  CONNECTED
  DISCONNECTED
  UNAUTHORIZED
  UNBOUND // freed slot via self-service HWID reset (enhancement §3)
}

// ─── Users ────────────────────────────────────────────────

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  supabaseId String?   @unique // Supabase Auth user UUID for binding
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  licenses   License[]
  payments   Payment[]
  frpRequests FrpUnlockRequest[]
  paymentOrders PaymentOrder[]
}

// ─── Plans ────────────────────────────────────────────────

model Plan {
  id           String    @id @default(cuid())
  slug         PlanType  @unique
  name         String
  priceCents   Int
  priceInr     Int       @default(0)
  currency     String    @default("USD")
  durationDays Int?
  deviceLimit  Int
  features     String[]
  createdAt    DateTime  @default(now())

  licenses License[]
}

// ─── Licenses ─────────────────────────────────────────────

model License {
  id             String        @id @default(cuid())
  key            String        @unique
  keySha256      String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan          @relation(fields: [planId], references: [id])
  status         LicenseStatus @default(ACTIVE)
  deviceLimit    Int
  maxActivations Int           @default(1)
  activatedAt    DateTime?
  expiresAt      DateTime?
  lastVerifiedAt DateTime?
  revealCount    Int           @default(0)
  lastRevealedAt DateTime?
  revokedReason  String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  devices   LicenseDevice[]
  payment   Payment?
  emailLogs EmailLog[]
  paymentOrder PaymentOrder?

  @@index([userId])
  @@index([status])
  @@index([metadata])
}

// ─── Dual-rail Payment Orders ─────────────────────────────

enum UpiOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  PENDING_VERIFICATION
}

model PaymentOrder {
  id        String         @id @default(cuid())
  orderId   String         @unique
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  planId    PlanType
  amount    Float
  currency  String         @default("INR")
  provider  String         @default("UPI")
  status    UpiOrderStatus @default(PENDING)
  utr       String?        @unique
  providerTxnId String?    @unique
  licenseId String?        @unique
  license   License?       @relation(fields: [licenseId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  expiresAt DateTime
  paidAt    DateTime?

  paymentConfirmed Boolean @default(false)
  utrSuspicious    Boolean @default(false)

  @@index([status, expiresAt])
  @@index([email])
  @@index([provider, status])
  @@index([paymentConfirmed, status])
  @@index([utrSuspicious])
}

// ─── Hardware-bound devices ───────────────────────────────

model LicenseDevice {
  id          String       @id @default(cuid())
  licenseId   String
  license     License      @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  hardwareId  String
  deviceName  String
  status      DeviceStatus @default(CONNECTED)
  lastSeenAt  DateTime     @default(now())
  unboundAt   DateTime?
  unbindCount Int          @default(0)
  createdAt   DateTime     @default(now())

  @@unique([licenseId, hardwareId])
  @@index([hardwareId])
}

// ─── Payments ─────────────────────────────────────────────

model Payment {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseId        String?         @unique
  license          License?        @relation(fields: [licenseId], references: [id])
  provider         PaymentProvider
  providerTxnId    String          @unique
  providerEventId  String?
  amountCents      Int
  currency         String          @default("USD")
  status           PaymentStatus   @default(PENDING)
  planSlug         PlanType
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([provider, providerTxnId])
}

// ─── Webhook Idempotency ─────────────────────────────────

model WebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventId     String          @unique
  eventType   String
  payload     Json
  status      String          @default("RECEIVED")
  processedAt DateTime?
  licenseId   String?
  error       String?
  createdAt   DateTime        @default(now())

  @@index([provider, status])
  @@index([licenseId])
}

// ─── Email Delivery Log ───────────────────────────────────

model EmailLog {
  id            String    @id @default(cuid())
  to            String
  template      String
  licenseId     String?
  license       License?  @relation(fields: [licenseId], references: [id])
  providerMsgId String?
  status        String    @default("QUEUED")
  error         String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  attempts      Int       @default(0)

  @@index([to])
  @@index([licenseId])
  @@index([status, createdAt])
}

// ─── FRP Unlock Requests ───────────────────────────────────

enum FrpRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model FrpUnlockRequest {
  id             String           @id @default(cuid())
  brand          String
  model          String
  androidVersion String?
  imeiHash       String?
  method         String
  ipAddress      String
  status         FrpRequestStatus @default(PENDING)
  statusMessage  String?
  result         Json?
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  requestedAt    DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  refundAmountCents Int?

  @@index([status])
  @@index([userId])
  @@index([imeiHash])
}
