{
  "name": "@frpb/shared",
  "version": "0.1.0",
  "private": true,
  "description": "FRPB shared types, constants and zod validation schemas (web + desktop)",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./analytics": {
      "types": "./src/analytics.ts",
      "node": "./dist/analytics.js",
      "require": "./dist/analytics.js",
      "import": "./src/analytics.ts",
      "default": "./dist/analytics.js"
    },
    "./free-tools": {
      "types": "./src/free-tools.ts",
      "node": "./dist/free-tools.js",
      "require": "./dist/free-tools.js",
      "import": "./src/free-tools.ts",
      "default": "./dist/free-tools.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
