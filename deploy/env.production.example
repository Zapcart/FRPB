# FRPB — production environment template for the AWS EC2 deployment.
#
# ⚠️ NAMES-ONLY template. NEVER commit real secret values.
# Copy to `apps/web/.env.production` on the server (gitignored) and fill it in:
#   cp deploy/env.production.example apps/web/.env.production
#   chmod 600 apps/web/.env.production
#
# This file is read BOTH at build time (NEXT_PUBLIC_* are inlined into the
# browser bundle) and at runtime (`next start` loads it automatically).
# Export it into the shell before building:
#   set -a; source apps/web/.env.production; set +a

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="3000"
# Bounded V8 heap so the process stops over-reserving memory on a small instance.
# Also set in deploy/ecosystem.config.cjs; keep the two in sync (384 ≈ t3.small).
NODE_OPTIONS="--max-old-space-size=384"

# ── Public app URL (canonical origin; drives sitemap + metadata) ──────────────
NEXT_PUBLIC_APP_URL="https://frpb.in"
NEXT_PUBLIC_APP_VERSION="<version>"

# ── Database (Supabase Postgres via Prisma) ───────────────────────────────────
# Runtime connection (pooled, PgBouncer transaction mode, port 6543).
DATABASE_URL="postgresql://<user>:<password>@<host>:6543/<db>?pgbouncer=true&connection_limit=1"
# Direct connection used by `prisma migrate deploy` (session mode, port 5432).
DIRECT_URL="postgresql://<user>:<password>@<host>:5432/<db>"

# ── Supabase Auth ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_SERVICE_ROLE_KEY="<server-only-service-role-key>"

# ── Razorpay (payments) ───────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_<public-key-id>"
RAZORPAY_KEY_SECRET="<server-only-key-secret>"
RAZORPAY_WEBHOOK_SECRET="<server-only-webhook-secret>"

# ── Admin console ─────────────────────────────────────────────────────────────
# Production owner credential for /admin. Server-only; fails CLOSED if unset.
ADMIN_LICENSE_KEY="<strong-random-owner-key>"
# Optional dev-only fallback (accepted ONLY when NODE_ENV !== "production").
ADMIN_DEV_KEY="<local-dev-only-key>"

# ── Analytics ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_<public-project-key>"
# Same-origin proxy through the app's /ingest/* rewrite (avoids ad blockers).
NEXT_PUBLIC_POSTHOG_HOST="https://frpb.in/ingest"
POSTHOG_API_KEY="phx_<server-only-personal-api-key>"
POSTHOG_HOST="https://<posthog-host>"
# Optional salt for first-party page-view hashing (falls back to a fixed value).
ANALYTICS_HASH_SALT="<random-32-char-string>"

# ── Email (Resend) ────────────────────────────────────────────────────────────
# RESEND_API_KEY must start with "re_" — the adapter validates the shape and
# fails fast otherwise. Send the mail from a VERIFIED Resend domain, else the
# provider rejects it (403-style "Invalid API key"/domain errors).
RESEND_API_KEY="re_<server-only-api-key>"
RESEND_FROM_EMAIL="FRPB <no-reply@<verified-domain>>"
# Legacy alias, still honored if RESEND_FROM_EMAIL is absent.
EMAIL_FROM="FRPB <no-reply@frpb.in>"
# Per-send timeout (ms) for the Resend API call. Defaults to 8000 when unset;
# a timeout is recorded as an EmailLog failure and retried by the cron drain.
RESEND_SEND_TIMEOUT_MS="8000"

# ── Test-key lockdown (security) ──────────────────────────────────────────────
# The master test-key shortcut FAILS CLOSED in production. Leave BOTH vars unset
# in production to keep it disabled entirely (recommended).
#
#   MASTER_TEST_LICENSE_KEY — provision a private, UNCOMMITTED secret here to
#     enable exactly ONE master key in production. Unset ⇒ shortcut off.
#   ALLOW_DEV_TEST_KEYS=true — DANGEROUS. Re-enables the published built-in key
#     FRPB-TEST-1234-5678 AND the whole FRPB-TEST-* prefix in production. Only
#     ever set this on a throwaway/non-customer environment.
# MASTER_TEST_LICENSE_KEY="<private-uncommitted-master-key>"
# ALLOW_DEV_TEST_KEYS="false"

# ── Jobs & cache (Upstash Redis) ──────────────────────────────────────────────
# Shared store used by the rate limiter AND the license/user TTL cache
# (src/lib/cache.ts). When either var is missing the cache DEGRADES to a
# per-process in-memory map: still correct (fail-open, just no cross-instance
# sharing), so the app boots and serves without Redis — but set BOTH in
# production so a multi-instance/PM2 cluster shares one cache.
CRON_SECRET="<strong-random-cron-secret>"
UPSTASH_REDIS_REST_URL="https://<region>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<server-only-upstash-token>"

# ── Public download assets (non-secret) ───────────────────────────────────────
NEXT_PUBLIC_DOWNLOAD_URL="https://github.com/Zapcart/FRPB-Application/releases/download/v1.0.0/FRPB-Recovery-Setup-1.0.1.exe"
DOWNLOAD_BASE_URL="https://github.com/Zapcart/FRPB-Application/releases/download/v1.0.0"

# ── Build control (optional) ──────────────────────────────────────────────────
# Set to 1 to skip `prisma migrate deploy` during build (CI without DB access).
# SKIP_PRISMA_MIGRATE=1
