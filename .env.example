# FRPB — environment template (BLUEPRINT ONLY).
#
# ⚠️ This file is a NAMES-ONLY template. NEVER put a real secret value in it:
# it is committed to the repository, so any value here is public forever and
# will also trip Netlify's secrets scanner if it matches a configured env var.
#
# Copy to `apps/web/.env.local` (gitignored) for local development, and set the
# same names in the Netlify UI for production. Replace every `<...>` placeholder.

# ── Database ──────────────────────────────────────────────────────────────────
# Runtime connection (pooled, PgBouncer transaction mode, port 6543).
DATABASE_URL="postgresql://<user>:<password>@<host>:6543/<db>?pgbouncer=true"
# Direct connection used by `prisma migrate` (session mode, port 5432).
# MUST be the non-pooled port: DDL cannot run through the transaction pooler.
DIRECT_URL="postgresql://<user>:<password>@<host>:5432/<db>"

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Public anon key (safe to expose to browsers — inlined into the client bundle).
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# ── Razorpay ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_<public-key-id>"
RAZORPAY_KEY_SECRET="<server-only-key-secret>"
RAZORPAY_WEBHOOK_SECRET="<server-only-webhook-secret>"

# ── Admin console ─────────────────────────────────────────────────────────────
# Production owner credential for /admin. Server-only; fails CLOSED if unset.
ADMIN_LICENSE_KEY="<strong-random-owner-key>"
# Development-only fallback credential. Accepted ONLY when NODE_ENV !== "production".
# Optional: leave unset and use ADMIN_LICENSE_KEY everywhere.
ADMIN_DEV_KEY="<local-dev-only-key>"

# ── Analytics ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_<public-project-key>"
NEXT_PUBLIC_POSTHOG_HOST="https://<posthog-host>"
POSTHOG_API_KEY="phx_<server-only-personal-api-key>"
POSTHOG_HOST="https://<posthog-host>"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_<server-only-api-key>"
EMAIL_FROM="FRPB <no-reply@<your-domain>>"

# ── Jobs & cache ──────────────────────────────────────────────────────────────
CRON_SECRET="<strong-random-cron-secret>"
UPSTASH_REDIS_REST_URL="https://<region>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<server-only-upstash-token>"

# ── Public app URLs / versions ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://<your-domain>"
NEXT_PUBLIC_APP_VERSION="<version>"
NEXT_PUBLIC_DOWNLOAD_URL="https://<your-domain>/download"
DOWNLOAD_BASE_URL="https://<release-host>"
